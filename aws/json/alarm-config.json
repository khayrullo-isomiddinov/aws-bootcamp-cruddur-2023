{
  "AlarmName": "DailyEstimatedCharges",
  "AlarmDescription": "This alarm triggers if daily estimated charges exceed 1 USD",
  "ActionsEnabled": true,
  "AlarmActions": [
    "arn:aws:sns:eu-central-1:792026110723:billing-alarm"
  ],
  "EvaluationPeriods": 1,
  "DatapointsToAlarm": 1,
  "Threshold": 1,
  "ComparisonOperator": "GreaterThanOrEqualToThreshold",
  "TreatMissingData": "breaching",
  "Metrics": [
    {
      "Id": "m1",
      "MetricStat": {
        "Metric": {
          "Namespace": "AWS/Billing",
          "MetricName": "EstimatedCharges",
          "Dimensions": [
            {
              "Name": "Currency",
              "Value": "USD"
            }
          ]
        },
        "Period": 86400,
        "Stat": "Maximum"
      },
      "ReturnData": false
    },
    {
      "Id": "e1",
      "Expression": "IF(RATE(m1)>0,RATE(m1)*86400,0)",
      "Label": "DailyEstimatedCharges",
      "ReturnData": true
    }
  ]
}